# ============================================================
# FriendMap Backend Environment Variables
# ============================================================

# Server
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL="mysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/friendmap"

# JWT
JWT_SECRET=friendmap_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=friendmap_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# CORS - Frontend origin
CORS_ORIGIN=http://localhost:3000

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Location
LOCATION_UPDATE_MIN_DISTANCE_M=5
LOCATION_UPDATE_MAX_AGE_S=30

# OSRM Routing (public demo, use your own for production)
OSRM_BASE_URL=https://router.project-osrm.org

# Arrival detection radius in meters
ARRIVAL_RADIUS_M=50
