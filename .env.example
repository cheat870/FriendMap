# ============================================================
# FRIENDMAP Root Environment Variables Example
# ============================================================

# Backend Port
PORT=5000

# Frontend URL for CORS
CORS_ORIGIN=http://localhost:3000

# Backend URL for Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Production Database (MySQL 8)
# DATABASE_URL="mysql://root:password@localhost:3306/friendmap"

# Development Database (SQLite)
DATABASE_URL="file:./dev.db"

# JWT Secrets (min 32 characters)
JWT_SECRET=friendmap_jwt_secret_dev_only_change_in_production_32ch
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=friendmap_refresh_jwt_secret_dev_only_change_prod
JWT_REFRESH_EXPIRES_IN=30d

# OSRM Routing Provider (Public demo or private instance)
OSRM_BASE_URL=https://router.project-osrm.org

# Arrival Radius in meters
ARRIVAL_RADIUS_M=50
